APP_ENV=dev
SECURE_MODE=true
LISTEN_ADDR=:3333
APP_JWT=ON
# ALLOW_UNSAFE_UNPROTECTED_MODE=true   # Required when APP_JWT=OFF (dev only, blocked in production)
LOG_LEVEL=debug
# TRUSTED_PROXY_CIDRS=10.42.0.0/16,10.0.0.0/8   # K3s pod CIDR + cluster CIDR for reverse proxy
DEFAULT_SERVICE_NAME=bootstrap
